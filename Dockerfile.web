# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files first for layer-cached restore
COPY ["Global Logistics Management System.csproj", "Global Logistics Management System/"]
RUN dotnet restore "Global Logistics Management System/Global Logistics Management System.csproj"

COPY . "Global Logistics Management System/"
WORKDIR "/src/Global Logistics Management System"
RUN dotnet publish "Global Logistics Management System.csproj" -c Release -o /app/publish

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 8080

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Global Logistics Management System.dll"]
