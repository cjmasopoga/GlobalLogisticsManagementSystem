@model Global_Logistics_Management_System.Models.Api.ServiceRequestDto
@{
    ViewData["Title"] = "Delete Service Request";
}

<h2 class="mb-4 text-danger">🗑️ Delete Service Request</h2>
<p class="text-muted">Are you sure you want to delete this service request?</p>

<div class="card shadow-sm col-md-6">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Contract</dt><dd class="col-sm-8">@Model.ContractServiceLevel</dd>
            <dt class="col-sm-4">Client</dt><dd class="col-sm-8">@Model.ClientName</dd>
            <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@Model.Description</dd>
            <dt class="col-sm-4">Cost (USD)</dt><dd class="col-sm-8">$@Model.CostUsd.ToString("N2")</dd>
            <dt class="col-sm-4">Cost (ZAR)</dt><dd class="col-sm-8">R@Model.CostZar.ToString("N2")</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
