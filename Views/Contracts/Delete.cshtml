@model Global_Logistics_Management_System.Models.Contract
@using Global_Logistics_Management_System.Models
@{
    ViewData["Title"] = "Delete Contract";
}

<h2 class="mb-4 text-danger">🗑️ Delete Contract</h2>
<p class="text-muted">Are you sure you want to delete this contract and all its service requests?</p>

<div class="card shadow-sm col-md-6">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Client</dt><dd class="col-sm-8">@Model.Client?.Name</dd>
            <dt class="col-sm-4">Service Level</dt><dd class="col-sm-8">@Model.ServiceLevel</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                <span class="badge bg-@(Model.Status == ContractStatus.Active ? "success" : Model.Status == ContractStatus.Expired ? "danger" : "secondary")">@Model.Status</span>
            </dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
