@model Global_Logistics_Management_System.Models.Api.CreateContractDto
@{
    ViewData["Title"] = "Edit Contract";
    var contractId = ViewBag.ContractId as int? ?? 0;
}

<h2 class="mb-4">✏️ Edit Contract</h2>

<div class="card shadow-sm col-md-7">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@contractId" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="ClientId" class="form-label">Client</label>
                <select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients">
                    <option value="">-- Select Client --</option>
                </select>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="col">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="ServiceLevel" class="form-label">Service Level</label>
                <input asp-for="ServiceLevel" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Draft">Draft</option>
                    <option value="Active">Active</option>
                    <option value="OnHold">On Hold</option>
                    <option value="Expired">Expired</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Replace Signed Agreement (PDF)</label>
                <input type="file" name="signedAgreement" accept=".pdf" class="form-control" />
                <div class="form-text">Upload a new PDF to replace. Leave blank to keep existing.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Update</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
