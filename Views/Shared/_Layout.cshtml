<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GLMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Global_Logistics_Management_System.styles.css" asp-append-version="true" />
    <style>
        .navbar-brand { font-weight: 700; color: #0d6efd !important; }
        .sidebar { min-height: calc(100vh - 56px); background: #1e2a3a; }
        .sidebar .nav-link { color: #adb5bd; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: #0d6efd; border-radius: 6px; }
        .sidebar .nav-heading { color: #6c757d; font-size: 0.75rem; text-transform: uppercase; letter-spacing: .08em; padding: .5rem 1rem; }
        .main-content { min-height: calc(100vh - 56px); }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    🚚 GLMS – TechMove Logistics
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("JwtToken")))
                        {
                            <li class="nav-item">
                                <span class="nav-link text-light opacity-75">
                                    👤 @Context.Session.GetString("Username")
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-light ms-2">Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar py-3">
                <div class="sidebar-sticky">
                    <p class="sidebar-heading">Management</p>
                    <ul class="nav flex-column px-2">
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Clients" asp-action="Index">👤 Clients</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Contracts" asp-action="Index">📄 Contracts</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Contracts" asp-action="Search">🔍 Search Contracts</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">📦 Service Requests</a>
                        </li>
                    </ul>
                    <hr class="text-secondary" />
                    <ul class="nav flex-column px-2">
                        <li class="nav-item mb-1">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">🏠 Dashboard</a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto main-content px-4 py-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
