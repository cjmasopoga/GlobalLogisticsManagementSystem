@model Global_Logistics_Management_System.Models.Api.ClientDto
@{
    ViewData["Title"] = "Client Details";
}

<h2 class="mb-4">👤 Client Details</h2>

<div class="card shadow-sm col-md-7 mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Contact Details</dt>
            <dd class="col-sm-9">@Model.ContactDetails</dd>
            <dt class="col-sm-3">Region</dt>
            <dd class="col-sm-9">@Model.Region</dd>
        </dl>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>

<h4>📄 Contracts (@Model.ContractCount)</h4>
<div class="card shadow-sm">
    <div class="card-body text-muted">
        <a asp-controller="Contracts" asp-action="Search" class="btn btn-sm btn-outline-primary">View contracts for this client</a>
    </div>
</div>
