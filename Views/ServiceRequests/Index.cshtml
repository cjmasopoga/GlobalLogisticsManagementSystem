@model IEnumerable<Global_Logistics_Management_System.Models.Api.ServiceRequestDto>
@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📦 Service Requests</h2>
    <a asp-action="Create" class="btn btn-primary">➕ New Service Request</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Contract</th>
                    <th>Client</th>
                    <th>Description</th>
                    <th>Cost (USD)</th>
                    <th>Cost (ZAR)</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ContractServiceLevel</td>
                        <td>@item.ClientName</td>
                        <td>@(item.Description.Length > 60 ? item.Description[..60] + "…" : item.Description)</td>
                        <td>$@item.CostUsd.ToString("N2")</td>
                        <td>R@item.CostZar.ToString("N2")</td>
                        <td><span class="badge bg-secondary">@item.Status</span></td>
                        <td>@item.CreatedAt.ToShortDateString()</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No service requests yet. <a asp-action="Create">Add one now.</a></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
