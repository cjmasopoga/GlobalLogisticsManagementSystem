@model Global_Logistics_Management_System.Models.Api.CreateServiceRequestDto
@{
    ViewData["Title"] = "Edit Service Request";
    var srId = ViewBag.ServiceRequestId as int? ?? 0;
}

<h2 class="mb-4">✏️ Edit Service Request</h2>

<div class="card shadow-sm col-md-7">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@srId">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="ContractId" class="form-label">Contract</label>
                <select asp-for="ContractId" class="form-select" asp-items="ViewBag.Contracts"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="CostUsd" class="form-label">Cost (USD)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="CostUsd" type="number" step="0.01" min="0" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Pending">Pending</option>
                    <option value="InProgress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Update</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
