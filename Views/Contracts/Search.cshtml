@model IEnumerable<Global_Logistics_Management_System.Models.Api.ContractDto>
@{
    ViewData["Title"] = "Search Contracts";
    var status = ViewBag.Status as string;
    var from = ViewBag.StartDateFrom as DateTime?;
    var to = ViewBag.StartDateTo as DateTime?;
}

<h2 class="mb-4">🔍 Search & Filter Contracts</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Search" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Start Date From</label>
                    <input type="date" name="startDateFrom" value="@(from?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Start Date To</label>
                    <input type="date" name="startDateTo" value="@(to?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">-- All Statuses --</option>
                        <option value="Draft" selected="@(status == "Draft")">Draft</option>
                        <option value="Active" selected="@(status == "Active")">Active</option>
                        <option value="OnHold" selected="@(status == "OnHold")">On Hold</option>
                        <option value="Expired" selected="@(status == "Expired")">Expired</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">🔍 Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <p class="text-muted">Found <strong>@Model.Count()</strong> contract(s).</p>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Client</th>
                    <th>Service Level</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ClientName</td>
                        <td>@item.ServiceLevel</td>
                        <td>@item.StartDate.ToShortDateString()</td>
                        <td>@item.EndDate.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-@(item.Status == "Active" ? "success" : item.Status == "Expired" ? "danger" : item.Status == "OnHold" ? "warning" : "secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <a asp-controller="Contracts" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-controller="Contracts" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No contracts matched your search criteria.</div>
}
