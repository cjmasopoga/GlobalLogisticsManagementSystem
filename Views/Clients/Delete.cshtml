@model Global_Logistics_Management_System.Models.Client
@{
    ViewData["Title"] = "Delete Client";
}

<h2 class="mb-4 text-danger">🗑️ Delete Client</h2>
<p class="text-muted">Are you sure you want to delete this client? This will also remove all associated contracts and service requests.</p>

<div class="card shadow-sm col-md-5">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Region</dt><dd class="col-sm-8">@Model.Region</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
