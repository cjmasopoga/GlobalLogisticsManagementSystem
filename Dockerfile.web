# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project file first for layer-cached restore
COPY ["Global Logistics Management System.csproj", "Web/"]
RUN dotnet restore "Web/Global Logistics Management System.csproj"

# Copy the rest of the MVC source
COPY . "Web/"
WORKDIR "/src/Web"
RUN dotnet publish "Global Logistics Management System.csproj" -c Release -o /app/publish

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 8080

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Global Logistics Management System.dll"]
