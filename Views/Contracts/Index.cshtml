@model IEnumerable<Global_Logistics_Management_System.Models.Contract>
@using Global_Logistics_Management_System.Models
@{
    ViewData["Title"] = "Contracts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📄 Contracts</h2>
    <div class="d-flex gap-2">
        <a asp-action="Search" class="btn btn-outline-secondary">🔍 Search / Filter</a>
        <a asp-action="Create" class="btn btn-primary">➕ New Contract</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Client</th>
                    <th>Service Level</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Agreement</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Client?.Name</td>
                        <td>@item.ServiceLevel</td>
                        <td>@item.StartDate.ToShortDateString()</td>
                        <td>@item.EndDate.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-@(item.Status == ContractStatus.Active ? "success" : item.Status == ContractStatus.Expired ? "danger" : item.Status == ContractStatus.OnHold ? "warning" : "secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.SignedAgreementPath))
                            {
                                <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">📥 Download</a>
                            }
                            else
                            {
                                <span class="text-muted small">None</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No contracts found. <a asp-action="Create">Add one now.</a></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
