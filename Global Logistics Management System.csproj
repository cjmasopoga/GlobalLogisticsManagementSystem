    <Compile Remove="Models\Client.cs" />
    <Compile Remove="Models\Contract.cs" />
    <Compile Remove="Models\ServiceRequest.cs" />
    <Compile Remove="Models\ContractSearchViewModel.cs" />
    <Compile Remove="Data\ApplicationDbContext.cs" />
    <Compile Remove="Services\CurrencyService.cs" />
    <Compile Remove="Services\ICurrencyService.cs" />
    <Compile Remove="Services\FileService.cs" />
