@model Global_Logistics_Management_System.Models.Contract
@using Global_Logistics_Management_System.Models
@{
    ViewData["Title"] = "Edit Contract";
}

<h2 class="mb-4">✏️ Edit Contract</h2>

<div class="card shadow-sm col-md-7">
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SignedAgreementPath" />
            <div class="mb-3">
                <label asp-for="ClientId" class="form-label"></label>
                <select asp-for="ClientId" class="form-select" asp-items="ViewBag.ClientId">
                    <option value="">-- Select Client --</option>
                </select>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="ServiceLevel" class="form-label"></label>
                <input asp-for="ServiceLevel" class="form-control" />
                <span asp-validation-for="ServiceLevel" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ContractStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Replace Signed Agreement (PDF)</label>
                @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
                {
                    <div class="mb-2">
                        <span class="text-success small">✅ Agreement on file.</span>
                        <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success ms-2">📥 Download Current</a>
                    </div>
                }
                <input type="file" name="signedAgreement" accept=".pdf" class="form-control" />
                <div class="form-text">Upload a new PDF to replace the existing one. Leave blank to keep existing.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Update</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
